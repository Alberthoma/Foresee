rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/wittfinances-282f1/users/{userId}/{collectionName}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // landing.html — captura de correo (acceso anticipado). Escritura pública
    // sin auth (es una landing de marketing, no la app), pero solo "create":
    // nunca se puede leer, editar ni borrar desde el cliente.
    match /landing_leads/{docId} {
      allow create: if request.resource.data.createdAt == request.time
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if false;
    }

    // landing.html — encuesta opcional de investigación (paso 2, "Ayúdanos a
    // mejorar Foresee"). Mismo criterio: solo "create", tope de campos como
    // mitigación básica de abuso.
    match /landing_survey/{docId} {
      allow create: if request.resource.data.createdAt == request.time
                    && request.resource.data.size() < 25;
      allow read, update, delete: if false;
    }
  }
}
